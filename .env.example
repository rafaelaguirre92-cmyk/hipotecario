# Google Sheets Integration (Service Account)
# El ID se encuentra en la URL de tu hoja de Google Sheets:
# https://docs.google.com/spreadsheets/d/[GOOGLE_SHEET_ID]/edit
GOOGLE_SHEET_ID=tu_google_sheet_id_aqui

# Nombre exacto de la pestaña donde se guardarán los prospectos (por defecto "Leads")
GOOGLE_SHEET_TAB=Leads

# Correo electrónico de la Service Account creada en Google Cloud Console
GOOGLE_CLIENT_EMAIL=hipoteca-leads@tu-proyecto.iam.gserviceaccount.com

# Llave privada de la Service Account (con saltos de línea \n o entre comillas)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Configuración de Notificaciones y Contacto
NEXT_PUBLIC_WHATSAPP_NUMBER=528180000000
NOTIFICATION_EMAIL=asesor@hipotecamty.com
NEXT_PUBLIC_SITE_URL=https://hipotecamty.com
